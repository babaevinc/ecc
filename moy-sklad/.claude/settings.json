{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(eas submit:*)",
      "Bash(npx eas submit:*)",
      "Edit(orchestrator/scope.json)",
      "Write(orchestrator/scope.json)",
      "Read(.env.production)",
      "Read(**/.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node orchestrator/guard.js --hook", "timeout": 10 }
        ]
      }
    ]
  }
}
